 34px rgba(255,105,0,.25),0 0 0 13px rgba(255,174,45,0)}100%{box-shadow:0 14px 34px rgba(255,105,0,.25),0 0 0 0 rgba(255,174,45,0)}}@keyframes iconFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}@keyframes dialogIn{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:none}}@media(max-width:650px){.menu-grid .menu-card:hover{transform:translateY(-3px) scale(1.005)!important}.home:before{width:230px;height:230px}.home:after{width:250px;height:250px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important;}}.header.scrolled{background:rgba(255,253,249,.94)!important;box-shadow:0 12px 34px rgba(75,40,8,.11)}</style></head><body><header class="header"><button class="brand" onclick="go('home')" aria-label="Beranda"><span class="logo"><img src="assets/image1.jpeg" alt="Potato SMP"></span>POTATO <span class="green">SMP</span></button><button id="profileChip" class="profile-chip" onclick="go('login')">👤 Login</button><button class="menu-btn" onclick="openMenu()" aria-label="Menu">☰</button></header><dialog id="menu"><div style="display:flex;justify-content:space-between;align-items:center"><b>MENU POTATO SMP</b><button class="copy" onclick="closeMenu()">Tutup</button></div><nav><button onclick="go('home')">🏠 Beranda</button><button onclick="go('server')">🌐 Server</button><button onclick="go('store')">👑 Rank & Store</button><button onclick="go('vote')">🗳️ Vote</button><button onclick="go('gamemode')">🎮 Gamemode</button><button onclick="go('guide')">📚 Panduan</button><button onclick="go('faq')">❓ FAQ</button><button onclick="go('community')">💬 Community</button><button onclick="go('gallery')">🖼️ Gallery</button><button onclick="go('rules')">📜 Aturan Server</button><button onclick="go('login')">👤 Login</button><button onclick="go('order')">🛒 Order WhatsApp</button></nav></dialog><section id="home" class="screen active home"><span class="kicker">🥔 OFFICIAL POTATO SMP</span><h1>Potato <span>SMP</span></h1><p class="lead">Survival Economy dengan progres multiplayer, aktivitas server, komunitas, Rank, Vote, dan panduan player baru dalam tampilan clean.</p><div class="actions"><button class="action primary" onclick="go('server')">🌐 Lihat Server</button><button class="action" onclick="go('login')">👤 Login Player</button></div><div class="tiktok-promo" id="tiktokPromo"><div class="tiktok-promo-icon">♪</div><div class="tiktok-promo-copy"><b>@potatosmp7</b><span>Follow TikTok Potato SMP untuk info & update server.</span></div><a class="tiktok-promo-btn" href="https://www.tiktok.com/@potatosmp7" target="_blank" rel="noopener noreferrer">Follow</a></div><div class="stats"><div><small>SERVER IP</small><b>potatosmp.fun</b></div><div><small>BEDROCK PORT</small><b>19132</b></div><div><small>JAVA</small><b>1.20+</b></div></div><div class="notice"><span class="notice-icon">👤</span><div class="notice-copy"><b id="noticeTitle">Belum login</b><span id="noticeText">Login untuk memakai Rank, Vote, dan Order.</span></div><button id="noticeButton" class="action primary" onclick="go('login')">LOGIN</button></div><div class="menu-grid"><button class="menu-card" onclick="go('server')"><span class="menu-icon">🌐</span><span><b>Server</b><small>IP, port & status</small></span></button><button class="menu-card" onclick="go('store')"><span class="menu-icon">👑</span><span><b>Rank & Store</b><small>Benefit & harga</small></span></button><button class="menu-card" onclick="go('vote')"><span class="menu-icon">🗳️</span><span><b>Vote</b><small>Support server</small></span></button><button class="menu-card" onclick="go('gamemode')"><span class="menu-icon">🎮</span><span><b>Gamemode</b><small>Aktivitas bermain</small></span></button><button class="menu-card" onclick="go('guide')"><span class="menu-icon">📚</span><span><b>Panduan</b><small>Player baru</small></span></button><button class="menu-card"