<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#fffaf3"><title>Potato SMP</title><style>:root{--o:#ff6900;--o2:#ff8b16;--y:#ffc928;--ink:#151515;--muted:#777;--line:#ece5dd;--soft:#fff8f0;--green:#169b72}*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink);background:#fff}body:before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(circle at 4% 2%,#ffc9282b,transparent 24%),radial-gradient(circle at 96% 10%,#ff69001b,transparent 25%),#fff}button,input,select{font:inherit}button{cursor:pointer}a{text-decoration:none;color:inherit}.header{position:sticky;top:0;z-index:40;height:68px;display:flex;align-items:center;padding:9px 4%;background:#ffffffef;backdrop-filter:blur(15px);border-bottom:1px solid var(--line)}.header:after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:linear-gradient(90deg,transparent,var(--y),var(--o),transparent)}.brand{display:flex;align-items:center;gap:10px;border:0;background:none;padding:0;font-size:18px;font-weight:950}.green{color:var(--green)}.logo{width:44px;height:44px;border-radius:13px;overflow:hidden;border:2px solid #fff;box-shadow:0 8px 22px #ff690027;background:#fff}.logo img{width:100%;height:100%;object-fit:cover;display:block}.profile-chip{margin-left:auto;margin-right:8px;padding:9px 11px;border:1px solid var(--line);border-radius:11px;background:#fffaf5;font-size:8px;font-weight:900;max-width:130px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.menu-btn{width:44px;height:44px;border:1px solid var(--line);border-radius:13px;background:#fff;font-size:19px}.screen{display:none;min-height:calc(100vh - 68px);padding:40px 15px 70px}.screen.active{display:block}.home{text-align:center;padding-top:62px}.kicker,.page-head span{display:inline-block;padding:7px 10px;border:1px solid #ffd4b3;border-radius:999px;background:var(--soft);color:var(--o);font-size:8px;font-weight:950;letter-spacing:1.3px}h1{margin:18px 0 12px;font-size:clamp(43px,11vw,78px);line-height:.93;letter-spacing:-3.5px}h1 span{color:var(--o)}.lead{max-width:580px;margin:auto;color:var(--muted);font-size:12px;line-height:1.8}.actions{display:flex;justify-content:center;flex-wrap:wrap;gap:9px;margin:23px 0 12px}.action{min-height:44px;padding:0 16px;border:1px solid var(--line);border-radius:12px;background:#fff;box-shadow:0 8px 22px #5b350f0b;font-size:9px;font-weight:950;transition:.18s}.action:hover{transform:translateY(-2px);border-color:#ffd0ac}.action.primary{border:0;color:#fff;background:linear-gradient(135deg,var(--o),var(--o2),var(--y));box-shadow:0 12px 28px #ff69002d}.full{width:100%;margin-top:9px}.stats{max-width:700px;margin:12px auto;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:17px;overflow:hidden;background:#fff}.stats div{padding:12px 5px;border-right:1px solid var(--line)}.stats div:last-child{border:0}.stats small{display:block;color:#999;font-size:7px}.stats b{font-size:10px}.notice{max-width:650px;margin:12px auto;display:flex;align-items:center;gap:9px;padding:8px;border:1px solid var(--line);border-radius:13px;background:#fff;box-shadow:0 8px 22px #5b350f0b;text-align:left}.notice-icon{width:31px;height:31px;display:grid;place-items:center;flex:0 0 31px;border-radius:9px;background:#fff1e5;border:1px solid #ffd9c0}.notice-copy{min-width:0;flex:1}.notice-copy b{display:block;font-size:9px}.notice-copy span{display:block;color:#888;font-size:7.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.notice .action{min-height:32px;padding:0 10px}.menu-grid{max-width:760px;margin:16px auto;display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.menu-card{min-height:78px;display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--line);border-radius:17px;background:#fff;box-shadow:0 9px 23px #5b350f0c;transition:.18s;text-align:left}.menu-card:hover{transform:translateY(-3px);border-color:#ffd0ac}.menu-icon{width:38px;height:38px;display:grid;place-items:center;flex:0 0 38px;border-radius:11px;background:linear-gradient(145deg,#fff0df,#fff);border:1px solid #ffdcc4}.menu-card b{display:block;font-size:9.5px}.menu-card small{display:block;color:#999;font-size:7px;margin-top:2px}.popular{max-width:760px;margin:30px auto;text-align:left}.popular h2{text-align:center;font-size:23px}.mini-grid{display:grid;gap:8px}.mini{padding:12px 14px;border:1px solid var(--line);border-radius:13px;background:#fff}.mini b{font-size:9px}.mini p{margin:3px 0 0;color:#777;font-size:8px}.page-head{max-width:760px;margin:20px auto 25px;text-align:center}.page-head h2{margin:10px 0 7px;font-size:clamp(30px,7vw,49px);line-height:1.03;letter-spacing:-2px}.page-head p{margin:0;color:#777;font-size:10px}.back{display:inline-block;padding:8px 11px;border:1px solid var(--line);border-radius:10px;background:#fff;font-size:8px;font-weight:900}.card,.rank,.feature,.login-card,.order-card,details{border:1px solid var(--line);border-radius:19px;background:#fff;box-shadow:0 15px 42px #5b350f0d}.card{max-width:850px;margin:auto;padding:18px}.connect{display:grid;gap:9px}.connect-row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px;border:1px solid var(--line);border-radius:13px}.connect-row small{display:block;color:#999;font-size:7px}.connect-row b{font-size:10px;word-break:break-all}.copy{padding:7px 9px;border:1px solid #ffd0ac;border-radius:8px;background:#fff5ed;color:var(--o);font-size:7px;font-weight:900}.rank-list{max-width:850px;margin:auto;display:grid;gap:11px}.rank{padding:16px;display:flex;align-items:center;gap:11px;flex-wrap:wrap}.rank-icon{width:44px;height:44px;display:grid;place-items:center;border-radius:13px;background:#fff0df;border:1px solid #ffd7bb;font-size:22px}.rank>div:nth-child(2){flex:1;min-width:160px}.rank h3{margin:0;color:var(--o);font-size:17px}.rank p{margin:2px 0;color:#777;font-size:8px}.rank strong{font-size:12px}.features{max-width:850px;margin:auto;display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.feature{padding:15px}.feature h3{margin:0 0 4px;font-size:11px}.feature p{margin:0;color:#777;font-size:8.5px;line-height:1.6}.profile{display:flex;align-items:center;gap:9px;padding:12px;border:1px dashed #ffd0ac;border-radius:12px;background:#fff9f3;margin-bottom:12px}.profile-main{flex:1;min-width:0}.profile small{display:block;color:var(--o);font-size:7px;font-weight:950}.profile b{display:block;font-size:11px;overflow:hidden;text-overflow:ellipsis}.tag{padding:5px 7px;border-radius:6px;background:#ffefe5;color:var(--o);font-size:7px;font-weight:950}.login-card,.order-card{max-width:480px;margin:auto;padding:22px}.login-icon{width:54px;height:54px;margin:auto;display:grid;place-items:center;border-radius:15px;background:#fff0df;border:1px solid #ffd7bb;font-size:24px}.login-title{text-align:center;color:var(--o);font-size:11px;font-weight:950;letter-spacing:1.3px;margin-top:8px}.login-state{text-align:center;color:var(--green);font-size:8px;font-weight:900;margin-top:4px}.login-sub{text-align:center;color:#888;font-size:8px;margin:4px 0 15px}.field{display:block;margin-top:9px;color:#666;font-size:8px;font-weight:900}.field input,.field select{width:100%;height:44px;margin-top:5px;padding:0 10px;border:1px solid #e4ddd5;border-radius:10px;background:#fff;outline:0;font-size:9px}.field input:focus,.field select:focus{border-color:#ffb27f;box-shadow:0 0 0 3px #ff69000c}.preview{margin:12px 0;padding:12px;border:1px dashed #ffd0ac;border-radius:12px;background:#fff9f3}.preview small{color:var(--o);font-size:7px;font-weight:950}.preview b{display:block;font-size:12px}.preview span{display:inline-block;margin-top:3px;padding:4px 7px;border-radius:6px;background:#ffefe5;color:var(--o);font-size:7px;font-weight:950}.preview em{display:block;color:#999;font-size:8px;font-style:normal;margin-top:3px}.clear{width:100%;margin-top:7px;padding:9px;border:1px solid var(--line);border-radius:10px;background:#fff;color:#777;font-size:8px;font-weight:900}.order-card{max-width:480px}.faq{max-width:850px;margin:auto;display:grid;gap:7px}details{padding:12px 14px}summary{cursor:pointer;list-style:none;font-size:9.5px;font-weight:950}summary::-webkit-details-marker{display:none}summary:after{content:"+";float:right;color:var(--o);font-size:13px}details[open] summary:after{content:"−"}details p{margin:8px 1px 0;color:#777;font-size:8.5px;line-height:1.7}.modal{position:fixed;inset:0;z-index:1000;display:none;align-items:center;justify-content:center;padding:16px;background:#2014084d;backdrop-filter:blur(5px)}.modal.show{display:flex}.modal-box{width:min(390px,92vw);padding:22px;text-align:center;border:1px solid var(--line);border-radius:21px;background:#fff9f1;box-shadow:0 25px 80px #0003}.modal-box .x{float:right;width:30px;height:30px;border:1px solid var(--line);border-radius:8px;background:#fff}.modal-box h3{margin:6px 0;font-size:20px}.modal-box p{color:#777;font-size:9px;line-height:1.7}#toast{position:fixed;z-index:1200;left:50%;bottom:17px;transform:translate(-50%,20px);opacity:0;padding:9px 12px;border-radius:10px;background:#171717;color:#fff;font-size:8px;transition:.2s}#toast.show{opacity:1;transform:translate(-50%,0)}dialog{width:min(360px,90vw);padding:17px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 25px 80px #0003}dialog::backdrop{background:#2014083d;backdrop-filter:blur(4px)}dialog nav{display:grid;gap:7px;margin-top:12px}dialog nav button{padding:11px;border:1px solid var(--line);border-radius:10px;background:#fffaf5;text-align:left;font-size:9px;font-weight:900}footer{padding:28px 15px;text-align:center;color:#999;border-top:1px solid var(--line);font-size:8px}@media(max-width:560px){.features{grid-template-columns:1fr 1fr}.rank{display:grid;grid-template-columns:44px 1fr}.rank .action{grid-column:1/-1}.order-grid{grid-template-columns:1fr 1fr}}:root{--shadow-soft:0 8px 24px rgba(60,34,8,.055);--shadow-card:0 14px 38px rgba(60,34,8,.075);--shadow-hover:0 18px 45px rgba(255,105,0,.12);}body{letter-spacing:.01em;}body:after{content:"";position:fixed;left:-80px;bottom:-120px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,#ffc92818 0%,transparent 70%);pointer-events:none;z-index:-1;}.header{box-shadow:0 5px 20px rgba(40,20,0,.045);}.brand{letter-spacing:-.7px;}.screen{animation:pageIn .24s ease both;}@keyframes pageIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}.action{box-shadow:var(--shadow-soft);}.action.primary{position:relative;overflow:hidden;}.action.primary:after{content:"";position:absolute;top:0;left:-70%;width:45%;height:100%;transform:skewX(-20deg);background:linear-gradient(90deg,transparent,#ffffff44,transparent);transition:.5s;}.action.primary:hover:after{left:125%}.stats,.notice,.menu-card,.card,.rank,.feature,.login-card,.order-card,details,.mini{box-shadow:var(--shadow-card);}.menu-card:active,.action:active{transform:translateY(1px);}.page-head h2{font-weight:950;}.page-head h2:after{content:"";display:block;width:42px;height:3px;margin:12px auto 0;border-radius:99px;background:linear-gradient(90deg,var(--o),var(--y));}.rank{position:relative;overflow:hidden;}.rank:before{content:"";position:absolute;top:-45px;right:-35px;width:130px;height:130px;border-radius:50%;background:radial-gradient(circle,#ffc9281d,transparent 68%);pointer-events:none;}.rank h3{font-weight:950;letter-spacing:-.4px;}.duration-pills{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px;}.duration-pills span{padding:4px 7px;border:1px solid #ffd8bd;border-radius:999px;background:#fff8f1;color:var(--o);font-size:6.5px;font-weight:950;letter-spacing:.4px;}.field input,.field select{box-shadow:inset 0 1px 2px rgba(40,20,0,.025);}.faq details{transition:.18s;}.faq details:hover{transform:translateY(-1px);box-shadow:0 12px 30px rgba(60,34,8,.085);}.faq summary{padding-right:18px;line-height:1.5;}.logo{box-shadow:0 8px 22px rgba(255,105,0,.12);}.profile-chip{box-shadow:0 5px 18px rgba(60,34,8,.04);}.faq-tabs{max-width:850px;margin:0 auto 12px;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}.faq-tab{min-height:44px;padding:8px 7px;border:1px solid var(--line);border-radius:13px;background:#fff;color:#444;font-size:8px;font-weight:950;box-shadow:0 7px 20px rgba(60,34,8,.05);transition:.18s;}.faq-tab:hover{transform:translateY(-2px);border-color:#ffd0ac;box-shadow:0 12px 25px rgba(255,105,0,.09);}.faq-tab.active{color:#fff;border-color:transparent;background:linear-gradient(135deg,var(--o),var(--o2),var(--y));box-shadow:0 10px 25px rgba(255,105,0,.18);}.faq-category-info{max-width:850px;margin:0 auto 10px;padding:13px 15px;border:1px solid #ffd8bd;border-radius:15px;background:linear-gradient(135deg,#fffaf4,#fff);box-shadow:0 9px 24px rgba(60,34,8,.055);}.faq-category-info b{display:block;color:var(--o);font-size:10px}.faq-category-info span{display:block;color:#888;font-size:8px;margin-top:3px}.faq-groups{max-width:850px;margin:auto}.faq-group{display:none;gap:7px}.faq-group.active{display:grid;animation:faqIn .2s ease both}@keyframes faqIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}.faq-group details{margin:0}.faq-group details[open]{border-color:#ffd5b8;box-shadow:0 13px 30px rgba(255,105,0,.07);}@media(max-width:560px){.faq-tabs{grid-template-columns:repeat(2,1fr)}.faq-tab{min-height:46px}}.rules-notice{max-width:850px;margin:0 auto 14px;padding:14px 15px;display:flex;gap:11px;align-items:center;border:1px solid #ffd8bd;border-radius:16px;background:linear-gradient(135deg,#fff8ef,#fff);box-shadow:0 10px 28px rgba(60,34,8,.055);}.rules-notice-icon{width:40px;height:40px;display:grid;place-items:center;flex:0 0 40px;border-radius:12px;background:#fff0df;font-size:19px}.rules-notice b{display:block;color:var(--o);font-size:10px}.rules-notice span{display:block;color:#888;font-size:8px;line-height:1.5;margin-top:2px}.rules-grid{max-width:850px;margin:auto;display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.rule-card{position:relative;padding:16px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 12px 32px rgba(60,34,8,.065);overflow:hidden;transition:.18s;}.rule-card:hover{transform:translateY(-2px);box-shadow:0 17px 38px rgba(255,105,0,.09);border-color:#ffd1b2}.rule-card:after{content:"";position:absolute;right:-45px;top:-45px;width:110px;height:110px;border-radius:50%;background:radial-gradient(circle,#ffc92818,transparent 68%);pointer-events:none}.rule-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}.rule-num{font-size:8px;font-weight:950;color:#999;letter-spacing:1px}.rule-badge{padding:5px 7px;border-radius:999px;font-size:6.5px;font-weight:950;letter-spacing:.5px;background:#fff5ed;color:var(--o);border:1px solid #ffd9c2}.rule-card h3{margin:0 0 6px;font-size:12px;line-height:1.35}.rule-card p{margin:0;color:#777;font-size:8.5px;line-height:1.65}.sanction{margin-top:11px;padding:9px;border-radius:10px;background:#fffaf5;border:1px solid #f2e5da;color:#777;font-size:7.5px;line-height:1.55}.sanction b{color:var(--o)}.sanction.danger{background:#fff7f5;border-color:#f2d5ce}.sanction.danger b{color:#d34d2e}.sanction-levels,.rules-footer-note{max-width:850px;margin:14px auto 0;padding:16px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 12px 32px rgba(60,34,8,.055)}.sanction-levels h3{margin:0 0 10px;font-size:12px}.level{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid #f1ebe5}.level:first-of-type{border-top:0}.level b{font-size:8px}.level span{color:#888;font-size:7.5px;text-align:right}.rules-footer-note b{font-size:9px;color:var(--o)}.rules-footer-note p{margin:6px 0 0;color:#777;font-size:8px;line-height:1.7}@media(max-width:620px){.rules-grid{grid-template-columns:1fr}.rules-notice{align-items:flex-start}.level{align-items:flex-start;flex-direction:column;gap:2px}.level span{text-align:left}}.rule-filter{max-width:850px;margin:0 auto 14px;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}.rule-filter-btn{min-height:44px;border:1px solid var(--line);border-radius:13px;background:#fff;font-size:8px;font-weight:950;box-shadow:0 7px 20px rgba(60,34,8,.05);transition:.18s;}.rule-filter-btn:hover{transform:translateY(-2px);border-color:#ffd0ac}.rule-filter-btn.active{color:#fff;border-color:transparent;background:linear-gradient(135deg,var(--o),var(--o2),var(--y));box-shadow:0 10px 26px rgba(255,105,0,.18);}.rule-card[data-hidden="true"]{display:none}.rule-badge.light{background:#effbf6;color:#169b72;border-color:#c9eddf}.rule-badge.medium{background:#fff9e8;color:#a16c00;border-color:#f5df9e}.rule-badge.heavy{background:#fff1ee;color:#d34d2e;border-color:#f1c6bc}.rule-card[data-level="heavy"]{border-color:#f1ddd8}.rule-card[data-level="heavy"]:hover{border-color:#efb9ad}@media(max-width:560px){.rule-filter{grid-template-columns:repeat(2,1fr)}}.rule-filter{max-width:850px;margin:0 auto 10px;display:grid;grid-template-columns:repeat(3,1fr);gap:9px;}.rule-intro{max-width:850px;margin:0 auto 13px;padding:13px 15px;display:flex;align-items:center;gap:10px;border:1px solid #ffd8bd;border-radius:15px;background:linear-gradient(135deg,#fffaf4,#fff);box-shadow:0 9px 25px rgba(60,34,8,.055);animation:faqIn .2s ease both;}.rule-intro-icon{width:38px;height:38px;display:grid;place-items:center;flex:0 0 38px;border-radius:11px;background:#fff0df;border:1px solid #ffd6ba;font-size:18px;}.rule-intro b{display:block;color:var(--o);font-size:9.5px}.rule-intro span{display:block;color:#888;font-size:7.8px;line-height:1.55;margin-top:2px}.rule-filter-btn{min-height:48px;border:1px solid var(--line);border-radius:14px;background:#fff;font-size:8.5px;font-weight:950;box-shadow:0 7px 20px rgba(60,34,8,.05);transition:.18s;}.rule-filter-btn:hover{transform:translateY(-2px);border-color:#ffd0ac}.rule-filter-btn.active{color:#fff;border-color:transparent;background:linear-gradient(135deg,var(--o),var(--o2),var(--y));box-shadow:0 10px 26px rgba(255,105,0,.18);}@media(max-width:560px){.rule-filter{grid-template-columns:repeat(3,1fr);gap:6px}.rule-filter-btn{font-size:7.5px;padding:0 3px}}.free-ranks{max-width:850px;margin:16px auto 0;padding:18px;border:1px solid #f1e1d5;border-radius:22px;background:linear-gradient(135deg,#fffaf5,#fff,#fff8ed);box-shadow:0 16px 42px rgba(60,34,8,.07);position:relative;overflow:hidden;}.free-ranks:before{content:"";position:absolute;right:-80px;top:-100px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,#ffc92822,transparent 68%);pointer-events:none;}.free-ranks-head{text-align:center;position:relative}.free-ranks-head span{font-size:7px;font-weight:950;color:var(--o);letter-spacing:1.3px}.free-ranks-head h3{margin:5px 0 3px;font-size:16px;letter-spacing:-.5px}.free-ranks-head p{margin:0;color:#888;font-size:8px}.free-rank-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:11px;margin-top:13px;position:relative}.free-rank-card{padding:15px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 12px 32px rgba(60,34,8,.06);transition:.18s;overflow:hidden;position:relative;}.free-rank-card:hover{transform:translateY(-2px);box-shadow:0 18px 40px rgba(255,105,0,.1)}.free-rank-card:after{content:"";position:absolute;right:-30px;bottom:-40px;width:120px;height:120px;border-radius:50%;background:radial-gradient(circle,#ffb32b15,transparent 70%);pointer-events:none}.free-rank-top{display:flex;align-items:center;justify-content:space-between}.free-rank-icon{font-size:22px}.free-rank-label{padding:5px 8px;border-radius:999px;background:#fff3e7;color:var(--o);border:1px solid #ffd7bc;font-size:6.5px;font-weight:950}.free-rank-card h4{margin:9px 