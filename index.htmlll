ion{display:block;padding:8px 9px 9px}.gallery-caption b{display:block;font-size:7.8px;color:#222}.gallery-caption small{display:block;margin-top:2px;font-size:6.4px;color:#999;line-height:1.4}.gallery-modal{position:fixed;inset:0;z-index:2500;display:none;place-items:center;padding:18px;background:rgba(18,12,8,.72);backdrop-filter:blur(7px)}.gallery-modal.open{display:grid;animation:galleryFade .18s ease both}.gallery-modal-box{width:min(920px,94vw);max-height:88vh;padding:8px;border-radius:18px;background:#fff;box-shadow:0 25px 70px rgba(0,0,0,.35)}.gallery-modal-box img{display:block;width:100%;max-height:78vh;object-fit:contain;border-radius:13px;background:#f4f1ef}.gallery-modal-title{padding:8px 4px 3px;font-size:8px;font-weight:900;color:#555}.gallery-close{position:fixed;right:15px;top:15px;width:42px;height:42px;border:1px solid rgba(255,255,255,.35);border-radius:14px;background:rgba(255,255,255,.95);font-size:25px;line-height:1;cursor:pointer;box-shadow:0 8px 25px rgba(0,0,0,.18)}@keyframes galleryFade{from{opacity:0;transform:scale(.985)}to{opacity:1;transform:scale(1)}}@media(max-width:700px){.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.gallery-head{margin-left:8px;margin-right:8px}.gallery-caption{padding:7px}.gallery-caption small{font-size:6px}}@media(max-width:400px){.gallery-grid{grid-template-columns:1fr 1fr}.gallery-caption b{font-size:7px}}#store{position:relative;isolation:isolate;overflow:hidden;}#store:before,#store:after{content:"";position:absolute;width:360px;height:360px;border-radius:50%;pointer-events:none;z-index:-1;filter:blur(8px);opacity:.55;}#store:before{left:-190px;top:120px;background:radial-gradient(circle,#ffc9282e 0%,transparent 68%);}#store:after{right:-190px;top:430px;background:radial-gradient(circle,#ff690022 0%,transparent 68%);}#store .page-head{padding:20px 15px 17px;border:1px solid #f0dfd3;border-radius:24px;background:radial-gradient(circle at 85% 15%,#ffc92822,transparent 28%),linear-gradien